<Window x:Class="WpfApp.ThemSuaDanhMuc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Thêm / Sửa Danh Mục" Height="550" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F8FAFC">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Vùng nhập liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="THÔNG TIN DANH MỤC" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <!-- KHU VỰC FORM NHẬP LIỆU -->
        <StackPanel Grid.Row="1">

            <!-- Nhập Tên danh mục -->
            <TextBlock Text="Tên danh mục:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTenDanhMuc" Height="45" Padding="10,0" FontSize="16" 
                     VerticalContentAlignment="Center" Margin="0,0,0,20" BorderBrush="#CBD5E1"
                     Tag="VD: Ăn uống, Mua sắm..." TextChanged="txtTenDanhMuc_TextChanged"/>

            <!-- Chọn Loại danh mục -->
            <TextBlock Text="Phân loại:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton x:Name="radChiTieu" Content="Chi tiêu" IsChecked="True" Foreground="#EF4444" FontWeight="Bold" FontSize="15" Margin="0,0,40,0"/>
                <RadioButton x:Name="radThuNhap" Content="Thu nhập" Foreground="#10B981" FontWeight="Bold" FontSize="15"/>
            </StackPanel>

            <!-- Chọn Icon (Biểu tượng) -->
            <TextBlock Text="Chọn biểu tượng (Icon):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboIcon" Height="45" VerticalContentAlignment="Center" FontSize="18" Margin="0,0,0,20" BorderBrush="#CBD5E1" SelectionChanged="cboIcon_SelectionChanged">
                <ComboBoxItem Content="🍔 Ăn uống" IsSelected="True"/>
                <ComboBoxItem Content="🚗 Đi lại"/>
                <ComboBoxItem Content="🛒 Mua sắm"/>
                <ComboBoxItem Content="🏠 Nhà cửa"/>
                <ComboBoxItem Content="💡 Hóa đơn"/>
                <ComboBoxItem Content="💰 Tiền lương"/>
                <ComboBoxItem Content="🎁 Quà tặng"/>
                <ComboBoxItem Content="❤️ Sức khỏe"/>
            </ComboBox>

            <!-- Chọn Màu sắc -->
            <TextBlock Text="Màu sắc đại diện:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboMauSac" Height="45" VerticalContentAlignment="Center" FontSize="15" Margin="0,0,0,20" BorderBrush="#CBD5E1" SelectionChanged="cboMauSac_SelectionChanged">
                <ComboBoxItem Content="🔴 Đỏ (Red)" IsSelected="True"/>
                <ComboBoxItem Content="🟢 Xanh lá (Green)"/>
                <ComboBoxItem Content="🔵 Xanh dương (Blue)"/>
                <ComboBoxItem Content="🟡 Vàng (Yellow)"/>
                <ComboBoxItem Content="🟠 Cam (Orange)"/>
                <ComboBoxItem Content="🟣 Tím (Purple)"/>
                <ComboBoxItem Content="⚫ Xám (Gray)"/>
            </ComboBox>

        </StackPanel>

        <!-- KHU VỰC NÚT HÀNH ĐỘNG -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <!-- Khoảng cách 2 nút -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nút Hủy -->
            <Button x:Name="btnHuy" Grid.Column="0" Content="Hủy bỏ" Height="45" 
                    Background="#94A3B8" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand" 
                    Click="btnHuy_Click"/>

            <!-- Nút Lưu -->
            <Button x:Name="btnLuu" Grid.Column="2" Content="💾 Lưu danh mục" Height="45" 
                    Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand" 
                    Click="btnLuu_Click"/>
        </Grid>
    </Grid>
</Window>