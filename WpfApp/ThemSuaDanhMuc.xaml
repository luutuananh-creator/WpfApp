<Window x:Class="WpfApp.ThemSuaDanhMuc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Thêm / Sửa Danh Mục" Height="570" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F6FA">

    <Window.Resources>
        <!-- Style chung cho các nút bấm bo góc -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Vùng nhập liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Thông tin danh mục" FontSize="22" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
            <TextBlock Text="Thiết lập tên, biểu tượng và màu sắc cho danh mục" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- KHU VỰC FORM NHẬP LIỆU -->
        <StackPanel Grid.Row="1">

            <!-- Nhập Tên danh mục (Được bọc Border bo góc) -->
            <TextBlock Text="Tên danh mục:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,6"/>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="42" Margin="0,0,0,16">
                <TextBox x:Name="txtTenDanhMuc" BorderThickness="0" Background="Transparent" 
                         VerticalContentAlignment="Center" FontSize="14" Padding="10,0"
                         TextChanged="txtTenDanhMuc_TextChanged"/>
            </Border>

            <!-- Chọn Loại danh mục -->
            <TextBlock Text="Phân loại:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="radChiTieu" Content="Chi tiêu" IsChecked="True" Foreground="#EF4444" FontWeight="Bold" FontSize="14" Margin="0,0,30,0"/>
                <RadioButton x:Name="radThuNhap" Content="Thu nhập" Foreground="#10B981" FontWeight="Bold" FontSize="14"/>
            </StackPanel>

            <!-- Chọn Icon (Biểu tượng) -->
            <TextBlock Text="Chọn biểu tượng (Icon):" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="cboIcon" Height="42" VerticalContentAlignment="Center" FontSize="15" Margin="0,0,0,16" SelectionChanged="cboIcon_SelectionChanged">
                <ComboBoxItem Content="🍔 Ăn uống" IsSelected="True"/>
                <ComboBoxItem Content="🚗 Đi lại"/>
                <ComboBoxItem Content="🛒 Mua sắm"/>
                <ComboBoxItem Content="🏠 Nhà cửa"/>
                <ComboBoxItem Content="💡 Hóa đơn"/>
                <ComboBoxItem Content="💰 Tiền lương"/>
                <ComboBoxItem Content="🎁 Quà tặng"/>
                <ComboBoxItem Content="❤️ Sức khỏe"/>
            </ComboBox>

            <!-- Chọn Màu sắc -->
            <TextBlock Text="Màu sắc đại diện:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="cboMauSac" Height="42" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,10" SelectionChanged="cboMauSac_SelectionChanged">
                <ComboBoxItem Content="🔴 Đỏ (Red)" IsSelected="True"/>
                <ComboBoxItem Content="🟢 Xanh lá (Green)"/>
                <ComboBoxItem Content="🔵 Xanh dương (Blue)"/>
                <ComboBoxItem Content="🟡 Vàng (Yellow)"/>
                <ComboBoxItem Content="🟠 Cam (Orange)"/>
                <ComboBoxItem Content="🟣 Tím (Purple)"/>
                <ComboBoxItem Content="⚫ Xám (Gray)"/>
            </ComboBox>

        </StackPanel>

        <!-- KHU VỰC NÚT HÀNH ĐỘNG -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <!-- Khoảng cách 2 nút -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nút Hủy -->
            <Button x:Name="btnHuy" Grid.Column="0" Content="Hủy bỏ" Height="42" 
                    Background="#94A3B8" Foreground="White" FontSize="14" 
                    Click="btnHuy_Click"/>

            <!-- Nút Lưu -->
            <Button x:Name="btnLuu" Grid.Column="2" Content="💾 Lưu danh mục" Height="42" 
                    Background="#10B981" Foreground="White" FontSize="14" 
                    Click="btnLuu_Click"/>
        </Grid>
    </Grid>
</Window>