<Page x:Class="WpfApp.NganSach"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản Lý Ngân Sách" Background="#F9FAFB">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Thanh công cụ & Lọc -->
            <RowDefinition Height="*"/>
            <!-- Bảng dữ liệu DataGrid -->
        </Grid.RowDefinitions>

        <!-- THANH CÔNG CỤ & BỘ LỌC -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Khối Bộ Lọc (Danh Mục, Tháng, Năm) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Lọc Danh Mục -->
                <TextBlock Text="Danh mục:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <ComboBox x:Name="cboLocDanhMuc" Width="160" Height="36" VerticalContentAlignment="Center" 
                          Margin="0,0,16,0" SelectionChanged="cboFilter_SelectionChanged"/>

                <!-- Lọc Tháng -->
                <TextBlock Text="Tháng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <ComboBox x:Name="cboLocThang" Width="90" Height="36" VerticalContentAlignment="Center" 
                          Margin="0,0,16,0" SelectionChanged="cboFilter_SelectionChanged"/>

                <!-- Lọc Năm -->
                <TextBlock Text="Năm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBox x:Name="txtLocNam" Width="80" Height="36" VerticalContentAlignment="Center" 
                         Padding="6,0" TextChanged="txtLocNam_TextChanged"/>
            </StackPanel>

            <!-- Các Nút Thêm, Sửa, Xóa -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnThemNganSach" Content="+ Thêm Ngân Sách" Height="36" Padding="12,0" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Margin="0,0,8,0" Click="btnThemNganSach_Click"/>

                <Button x:Name="btnSuaNganSach" Content="Sửa Hạn Mức" Height="36" Padding="12,0" 
                        Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Margin="0,0,8,0" Click="btnSuaNganSach_Click"/>

                <Button x:Name="btnXoaNganSach" Content="Xóa" Height="36" Padding="12,0" 
                        Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Click="btnXoaNganSach_Click"/>
            </StackPanel>
        </Grid>

        <!-- BẢNG DATAGRID -->
        <DataGrid x:Name="dgvNganSach" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" 
                  Background="White" RowHeight="40" ColumnHeaderHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NS" Binding="{Binding MaNganSach}" Width="70"/>
                <DataGridTextColumn Header="Tên Danh Mục" Binding="{Binding TenDanhMuc}" Width="*"/>
                <DataGridTextColumn Header="Hạn Mức (VNĐ)" Binding="{Binding HanMuc, StringFormat={}{0:N0}}" Width="130"/>
                <DataGridTextColumn Header="Đã Chi (VNĐ)" Binding="{Binding DaChi, StringFormat={}{0:N0}}" Width="130"/>
                <DataGridTextColumn Header="Còn Lại (VNĐ)" Binding="{Binding ConLai, Mode=OneWay, StringFormat={}{0:N0}}" Width="130"/>

                <!-- Thanh Tiến Độ -->
                <DataGridTemplateColumn Header="Tiến Độ Sử Dụng" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="5,0">
                                <ProgressBar Value="{Binding PhanTramDung, Mode=OneWay}" Maximum="100" Height="14" 
                                             Foreground="{Binding MauTienDo, Mode=OneWay}" Background="#E5E7EB" BorderThickness="0"/>
                                <TextBlock Text="{Binding PhanTramHienThi, Mode=OneWay}" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#111827"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>