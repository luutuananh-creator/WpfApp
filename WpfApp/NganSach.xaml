<Page x:Class="WpfApp.NganSach"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Quản Lý Ngân Sách" Background="#F5F6FA">

    <Page.Resources>
        <!-- Style chung cho các nút bấm -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 0: Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 1: Thanh công cụ & Lọc -->
            <RowDefinition Height="15"/>
            <!-- Khoảng cách -->
            <RowDefinition Height="*"/>
            <!-- Dòng 3: Bảng dữ liệu DataGrid -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Quản lý ngân sách" FontSize="24" FontWeight="Bold" Foreground="#1F2937"/>
            <TextBlock Text="Thiết lập hạn mức chi tiêu và theo dõi tiến độ sử dụng ngân sách của bạn" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- THANH CÔNG CỤ & BỘ LỌC -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Khối Bộ Lọc (Danh Mục, Tháng, Năm) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Lọc Danh Mục -->
                <TextBlock Text="Danh mục:" VerticalAlignment="Center" Foreground="#374151" FontWeight="Medium" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboLocDanhMuc" Width="150" Height="38" VerticalContentAlignment="Center" 
                          Margin="0,0,14,0" SelectionChanged="cboFilter_SelectionChanged"/>

                <!-- Lọc Tháng -->
                <TextBlock Text="Tháng:" VerticalAlignment="Center" Foreground="#374151" FontWeight="Medium" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboLocThang" Width="85" Height="38" VerticalContentAlignment="Center" 
                          Margin="0,0,14,0" SelectionChanged="cboFilter_SelectionChanged"/>

                <!-- Lọc Năm -->
                <TextBlock Text="Năm:" VerticalAlignment="Center" Foreground="#374151" FontWeight="Medium" Margin="0,0,8,0"/>
                <Border Width="80" Height="38" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <TextBox x:Name="txtLocNam" BorderThickness="0" Background="Transparent" 
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Padding="4,0" TextChanged="txtLocNam_TextChanged" FontSize="13"/>
                </Border>
            </StackPanel>

            <!-- Các Nút Thêm, Sửa, Xóa -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnThemNganSach" Content="＋ Thêm Ngân sách" Width="145" Height="38" 
                        Background="#10B981" Foreground="White" Margin="0,0,10,0" Click="btnThemNganSach_Click"/>

                <Button x:Name="btnSuaNganSach" Content="✏️ Sửa hạn mức" Width="125" Height="38" 
                        Background="#F59E0B" Foreground="White" Margin="0,0,10,0" Click="btnSuaNganSach_Click"/>

                <Button x:Name="btnXoaNganSach" Content="🗑️ Xóa" Width="85" Height="38" 
                        Background="#EF4444" Foreground="White" Click="btnXoaNganSach_Click"/>
            </StackPanel>
        </Grid>

        <!-- BẢNG DATAGRID BỌC TRONG BORDER BO GÓC -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="1">
            <DataGrid x:Name="dgvNganSach" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                      Background="Transparent" BorderThickness="0" RowHeight="45" ColumnHeaderHeight="42"
                      FontSize="14" SelectionMode="Single" SelectionUnit="FullRow">

                <!-- Style tiêu đề cột -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã NS" Binding="{Binding MaNganSach}" Width="80"/>
                    <DataGridTextColumn Header="Tên Danh Mục" Binding="{Binding TenDanhMuc}" Width="*"/>
                    <DataGridTextColumn Header="Hạn Mức (VNĐ)" Binding="{Binding HanMuc, StringFormat={}{0:N0}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Đã Chi (VNĐ)" Binding="{Binding DaChi, StringFormat={}{0:N0}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Còn Lại (VNĐ)" Binding="{Binding ConLai, Mode=OneWay, StringFormat={}{0:N0}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Thanh Tiến Độ -->
                    <DataGridTemplateColumn Header="Tiến Độ Sử Dụng" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="10,0">
                                    <ProgressBar Value="{Binding PhanTramDung, Mode=OneWay}" Maximum="100" Height="14" 
                                                 Foreground="{Binding MauTienDo, Mode=OneWay}" Background="#E5E7EB" BorderThickness="0"/>
                                    <TextBlock Text="{Binding PhanTramHienThi, Mode=OneWay}" HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#111827"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>