<Page x:Class="WpfApp.GiaoDich"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="GiaoDich">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 0: Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 1: Thanh Tìm kiếm, Lọc & AI -->
            <RowDefinition Height="*"/>
            <!-- Dòng 2: Bảng DataGrid hiển thị dữ liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 3: Nút Thêm, Sửa, Xóa -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="QUẢN LÝ GIAO DỊCH" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC & AI -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Vùng tìm kiếm và lọc -->
                <ColumnDefinition Width="Auto"/>
                <!-- Vùng nút AI -->
            </Grid.ColumnDefinitions>

            <!-- Cụm Tìm kiếm & Lọc (Trái) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Ô tìm kiếm -->
                <TextBox x:Name="txtTimKiem" Width="200" Height="35" Padding="10,8" Margin="0,0,10,0" 
                         VerticalContentAlignment="Center" Text="🔍 Nhập ghi chú..."/>

                <!-- Lọc Thời gian -->
                <ComboBox x:Name="cboLocThoiGian" Width="120" Height="35" VerticalContentAlignment="Center" Margin="0,0,10,0">
                    <ComboBoxItem Content="Tháng này" IsSelected="True"/>
                    <ComboBoxItem Content="Tháng trước"/>
                    <ComboBoxItem Content="Tất cả thời gian"/>
                </ComboBox>

                <!-- Lọc Danh mục -->
                <ComboBox x:Name="cboLocDanhMuc" Width="120" Height="35" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Tất cả danh mục" IsSelected="True"/>
                    <ComboBoxItem Content="Thu nhập"/>
                    <ComboBoxItem Content="Chi tiêu"/>
                </ComboBox>
            </StackPanel>

            <!-- Cụm nút AI (Phải) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnQuetHoaDon" Content="📷 Quét hóa đơn" Height="35" Padding="15,0" Margin="0,0,10,0"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="btnQuetHoaDon_Click"/>

                <Button x:Name="btnNhapBangAI" Content="✨ Nhập bằng AI" Height="35" Padding="15,0"
                        Background="#6366F1" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="btnNhapBangAI_Click"/>
            </StackPanel>
        </Grid>

        <!-- BẢNG DỮ LIỆU (DATAGRID) -->
        <DataGrid x:Name="dgvGiaoDich" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" 
                  HeadersVisibility="Column" Background="White" RowHeight="35" ColumnHeaderHeight="40"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1">
            <DataGrid.Columns>
                <!-- Cột Ngày -->
                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay}" Width="100"/>
                <!-- Cột Phân loại (Thu/Chi) -->
                <DataGridTextColumn Header="Loại" Binding="{Binding Loai}" Width="80"/>
                <!-- Cột Danh mục -->
                <DataGridTextColumn Header="Danh mục" Binding="{Binding DanhMuc}" Width="150"/>
                <!-- Cột Ghi chú -->
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                <!-- Cột Số tiền (Căn phải để số dễ đọc) -->
                <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- THANH NÚT HÀNH ĐỘNG DƯỚI CÙNG -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Nút Thêm bên trái -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Nút Sửa/Xóa bên phải -->
            </Grid.ColumnDefinitions>

            <!-- Nút Thêm mới (Chính) -->
            <Button x:Name="btnThemGiaoDich" Grid.Column="0" Content="➕ Thêm Giao dịch" Height="40" Padding="20,0" 
                    Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="btnThemGiaoDich_Click"/>

            <!-- Nút Sửa / Xóa (Phụ) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnSuaGiaoDich" Content="✏️ Sửa" Height="40" Width="90" Margin="0,0,10,0"
                        Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="btnSuaGiaoDich_Click"/>

                <Button x:Name="btnXoaGiaoDich" Content="🗑️ Xóa" Height="40" Width="90"
                        Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="btnXoaGiaoDich_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>