<Page x:Class="WpfApp.CaiDat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Cài đặt"
      Background="#F5F7FA">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Cài đặt" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
            <TextBlock Text="Quản lý tài khoản và cấu hình hệ thống"
                       FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">

            <!-- Card: Thông tin cá nhân -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="#DBEAFE" Margin="0,0,16,0">
                        <TextBlock Text="👤" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thông tin cá nhân" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="Cập nhật họ tên, email và thông tin tài khoản"
                                   FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="btnThongTinCaNhan" Content="Mở  ›"
                            Click="btnThongTinCaNhan_Click"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0" Padding="16,8" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Card: Đổi mật khẩu -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="#FEF3C7" Margin="0,0,16,0">
                        <TextBlock Text="🔒" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Đổi mật khẩu" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="Thay đổi mật khẩu đăng nhập của bạn"
                                   FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="btnDoiMatKhau" Content="Mở  ›"
                            Click="btnDoiMatKhau_Click"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0" Padding="16,8" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Card: Cài đặt chung -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="#DCFCE7" Margin="0,0,16,0">
                        <TextBlock Text="🛠️" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cài đặt chung" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="Đơn vị tiền tệ mặc định và hạn mức cảnh báo"
                                   FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="btnCaiDatChung" Content="Mở  ›"
                            Click="btnCaiDatChung_Click"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0" Padding="16,8" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Card: Đăng xuất -->
            <Border Background="#FEF2F2" CornerRadius="12" Padding="20" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="#FEE2E2" Margin="0,0,16,0">
                        <TextBlock Text="🚪" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Đăng xuất" FontSize="15" FontWeight="SemiBold" Foreground="#991B1B"/>
                        <TextBlock Text="Thoát khỏi tài khoản hiện tại và quay về màn hình đăng nhập"
                                   FontSize="12" Foreground="#B91C1C" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="btnDangXuat" Content="Đăng xuất"
                            Click="btnDangXuat_Click"
                            Background="#EF4444" Foreground="White"
                            BorderThickness="0" Padding="16,8" Cursor="Hand"/>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</Page>