<Page x:Class="WpfApp.TroLyAI"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="TroLyAI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 0: Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- Dòng 1: Nội dung chính -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="TRỢ LÝ AI TÀI CHÍNH" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- KHU VỰC CHÍNH CHIA 2 CỘT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <!-- Cột trái: Công cụ AI -->
                <ColumnDefinition Width="20"/>
                <!-- Khoảng cách 2 cột -->
                <ColumnDefinition Width="*"/>
                <!-- Cột phải: Chatbot -->
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: CÁC CÔNG CỤ THAO TÁC NHANH -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="⚡ CÔNG CỤ NHANH" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,15"/>

                <!-- Nút Quét hóa đơn -->
                <Button x:Name="btnQuetHoaDon" Content="📷 Quét hóa đơn" Height="50" Margin="0,0,0,15" 
                        Background="#8B5CF6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="btnQuetHoaDon_Click"/>

                <!-- Nút Nhập giao dịch bằng AI -->
                <Button x:Name="btnNhapGiaoDich" Content="📝 Nhập bằng AI" Height="50" Margin="0,0,0,15" 
                        Background="#6366F1" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="btnNhapGiaoDich_Click"/>

                <!-- Nút Phân tích tài chính -->
                <Button x:Name="btnPhanTich" Content="📈 Phân tích thông minh" Height="50" 
                        Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="btnPhanTich_Click"/>
            </StackPanel>

            <!-- CỘT PHẢI: GIAO DIỆN CHATBOT -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header chat -->
                        <RowDefinition Height="*"/>
                        <!-- Khu vực tin nhắn -->
                        <RowDefinition Height="Auto"/>
                        <!-- Khung nhập chat -->
                    </Grid.RowDefinitions>

                    <!-- Khung tiêu đề Chat -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15">
                        <TextBlock Text="🤖 Trò chuyện với Gemini AI" FontWeight="Bold" Foreground="#334155" FontSize="16"/>
                    </Border>

                    <!-- Khung hiển thị lịch sử tin nhắn -->
                    <ScrollViewer Grid.Row="1" Margin="15" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Tin nhắn mẫu của AI (Căn trái, nền xám nhạt) -->
                            <Border Background="#F1F5F9" Padding="15" CornerRadius="8,8,8,0" HorizontalAlignment="Left" MaxWidth="350" Margin="0,0,0,15">
                                <TextBlock Text="Chào bạn! Mình là Trợ lý AI. Bạn cần mình giúp gì hôm nay? (Ví dụ: Thêm giao dịch ăn sáng 35k, hoặc Phân tích chi tiêu tuần này)" TextWrapping="Wrap" LineHeight="20"/>
                            </Border>

                            <!-- Tin nhắn mẫu của Người dùng (Căn phải, nền xanh lá/xanh dương) -->
                            <Border Background="#10B981" Padding="15" CornerRadius="8,8,0,8" HorizontalAlignment="Right" MaxWidth="350" Margin="0,0,0,15">
                                <TextBlock Text="Hôm nay mình ăn sáng hết 35k và đổ xăng 50k." Foreground="White" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Tin nhắn mẫu AI phản hồi -->
                            <Border Background="#F1F5F9" Padding="15" CornerRadius="8,8,8,0" HorizontalAlignment="Left" MaxWidth="350" Margin="0,0,0,15">
                                <TextBlock Text="Đã nhận diện 2 giao dịch:&#x0a;1. Ăn uống: 35,000 đ&#x0a;2. Đi lại (Đổ xăng): 50,000 đ&#x0a;Bạn có muốn lưu vào hệ thống không?" TextWrapping="Wrap" LineHeight="20"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Khung nhập liệu ở dưới cùng -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ô nhập text -->
                            <TextBox x:Name="txtChatInput" Grid.Column="0" Height="45" VerticalContentAlignment="Center" Padding="15,0"
                                     BorderThickness="1" BorderBrush="#CBD5E1" Text="Nhập yêu cầu của bạn vào đây..."/>

                            <!-- Nút Gửi -->
                            <Button x:Name="btnGuiTinNhan" Grid.Column="1" Content="Gửi 🚀" Width="80" Height="45" Margin="10,0,0,0" 
                                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                    Click="btnGuiTinNhan_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>