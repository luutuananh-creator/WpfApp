<Window x:Class="WpfApp.ThemSuaGiaoDich"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="ThemSuaGiaoDich" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="btnLuu" Content="Lưu" Height="40" Click="btnLuu_Click"/>
            <Button x:Name="btnHuy" Content="Hủy" Height="40" Click="btnHuy_Click"/>
        </StackPanel>
    </Grid>
</Window>
