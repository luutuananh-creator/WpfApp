<Window x:Class="WpfApp.ThemSuaGiaoDich"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Thêm / Sửa Giao Dịch" Height="680" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F6FA">

    <Window.Resources>
        <!-- Style chung cho các nút bấm bo góc -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Vùng nhập liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Chi tiết giao dịch" FontSize="22" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
            <TextBlock Text="Nhập thông tin chi tiết cho khoản thu hoặc chi của bạn" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- KHU VỰC FORM NHẬP LIỆU -->
        <StackPanel Grid.Row="1">

            <!-- Nhập Số tiền (Bọc Border bo góc) -->
            <TextBlock Text="Số tiền (VND):" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="42" Margin="0,0,0,14">
                <TextBox x:Name="txtSoTien" BorderThickness="0" Background="Transparent" 
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right" 
                         FontSize="16" FontWeight="Bold" Padding="10,0"
                         TextChanged="txtSoTien_TextChanged"/>
            </Border>

            <!-- Chọn Loại giao dịch (Thu / Chi) -->
            <TextBlock Text="Loại giao dịch:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="radChiTieu" Content="Chi tiêu (-)" IsChecked="True" Foreground="#EF4444" FontWeight="Bold" FontSize="14" Margin="0,0,30,0" Checked="radChiTieu_Checked"/>
                <RadioButton x:Name="radThuNhap" Content="Thu nhập (+)" Foreground="#10B981" FontWeight="Bold" FontSize="14" Checked="radThuNhap_Checked"/>
            </StackPanel>

            <!-- Chọn Ngày -->
            <TextBlock Text="Ngày giao dịch:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpNgay" Height="40" FontSize="14" Margin="0,0,0,14"/>

            <!-- Chọn Danh mục & Nút Quản lý -->
            <TextBlock Text="Danh mục:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="cboDanhMuc" Grid.Column="0" Height="40" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0" DisplayMemberPath="TenDanhMuc" SelectedValuePath="MaDanhMuc" SelectionChanged="cboDanhMuc_SelectionChanged"/>

                <Button x:Name="btnQuanLyDanhMuc" Grid.Column="1" Content="⚙️ Quản lý" Width="90" Height="40" 
                        Background="#E5E7EB" Foreground="#374151" FontSize="13"
                        Click="btnQuanLyDanhMuc_Click"/>
            </Grid>

            <!-- Phương thức thanh toán -->
            <TextBlock Text="Phương thức thanh toán:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboPhuongThuc" Height="40" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,14" SelectionChanged="cboPhuongThuc_SelectionChanged">
                <ComboBoxItem Content="Tiền mặt" IsSelected="True"/>
                <ComboBoxItem Content="Chuyển khoản ngân hàng"/>
                <ComboBoxItem Content="Ví điện tử (MoMo, ZaloPay...)"/>
            </ComboBox>

            <!-- Ghi chú thêm -->
            <TextBlock Text="Ghi chú:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="70" Margin="0,0,0,5">
                <TextBox x:Name="txtGhiChu" BorderThickness="0" Background="Transparent" 
                         Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" FontSize="13"
                         TextChanged="txtGhiChu_TextChanged"/>
            </Border>

        </StackPanel>

        <!-- KHU VỰC NÚT HÀNH ĐỘNG -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <!-- Khoảng cách 2 nút -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnHuy" Grid.Column="0" Content="Hủy bỏ" Height="42" 
                    Background="#94A3B8" Foreground="White" FontSize="14" 
                    Click="btnHuy_Click"/>

            <Button x:Name="btnLuu" Grid.Column="2" Content="💾 Lưu giao dịch" Height="42" 
                    Background="#3B82F6" Foreground="White" FontSize="14" 
                    Click="btnLuu_Click"/>
        </Grid>
    </Grid>
</Window>