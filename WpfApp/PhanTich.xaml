<Page x:Class="WpfApp.PhanTich"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1200"
      Title="PhanTich" Background="#F5F6FA">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Phân tích tài chính" FontSize="24" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="Trực quan hóa dòng tiền, cơ cấu thu chi và so sánh tháng" 
                           FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2 BIỂU ĐỒ ĐỘC LẬP -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================ -->
                <!-- CỘT TRÁI: BIỂU ĐỒ TRÒN + BỘ LỌC RIÊNG      -->
                <!-- ============================================ -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" 
                        BorderThickness="1" CornerRadius="12" Padding="20" MinHeight="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề -->
                        <TextBlock x:Name="txtTieuDeBieuDoTron" Text="CƠ CẤU CHI TIÊU" 
                                   FontWeight="Bold" FontSize="14" Foreground="#4B5563" 
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <!-- BỘ LỌC RIÊNG CHO BIỂU ĐỒ TRÒN -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <!-- ⭐ HÀNG NGANG: Thời gian + Xem theo -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⏳ Thời gian:" VerticalAlignment="Center" 
                                           FontSize="13" FontWeight="Medium" 
                                           Foreground="#374151" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboLocThoiGian" Width="170" Height="34" 
                                          VerticalContentAlignment="Center" Margin="0,0,16,0"
                                          SelectionChanged="cboLocThoiGian_SelectionChanged" 
                                          FontSize="12">
                                    <ComboBoxItem Content="Hôm nay"/>
                                    <ComboBoxItem Content="Hôm qua"/>
                                    <ComboBoxItem Content="7 ngày gần đây"/>
                                    <ComboBoxItem Content="30 ngày gần đây"/>
                                    <ComboBoxItem Content="Tuần này"/>
                                    <ComboBoxItem Content="Tháng này" />
                                    <ComboBoxItem Content="Tháng trước"/>
                                    <ComboBoxItem Content="Năm nay"/>
                                    <ComboBoxItem Content="📅 Tùy chọn khoảng ngày" IsSelected="True"/>
                                </ComboBox>

                                <TextBlock Text="📊 Xem theo:" VerticalAlignment="Center" 
                                           FontSize="13" FontWeight="Medium" 
                                           Foreground="#374151" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboLoaiBieuDo" Width="150" Height="34" 
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="cboLoaiBieuDo_SelectionChanged" 
                                          FontSize="12">
                                    <ComboBoxItem Content="Tổng hợp" IsSelected="True"/>
                                    <ComboBoxItem Content="Chỉ xem Chi tiêu"/>
                                    <ComboBoxItem Content="Chỉ xem Thu nhập"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Panel DatePicker -->
                            <Border x:Name="pnlChonKhoangNgay" 
                                    Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                    CornerRadius="6" Padding="8,6" 
                                    Visibility="Collapsed" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="📅 Từ:" VerticalAlignment="Center" 
                                                   FontSize="12" FontWeight="Medium" 
                                                   Foreground="#1E40AF" Margin="0,0,6,0"/>
                                        <DatePicker x:Name="dpTuNgay" Width="120" Height="30" 
                                                    FontSize="12" Margin="0,0,10,0"
                                                    SelectedDateChanged="dpTuNgay_SelectedDateChanged"/>

                                        <TextBlock Text="Đến:" VerticalAlignment="Center" 
                                                   FontSize="12" FontWeight="Medium" 
                                                   Foreground="#1E40AF" Margin="0,0,6,0"/>
                                        <DatePicker x:Name="dpDenNgay" Width="120" Height="30" 
                                                    FontSize="12"
                                                    SelectedDateChanged="dpDenNgay_SelectedDateChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Nhanh:" VerticalAlignment="Center" 
                                                   FontSize="11" Foreground="#6B7280" 
                                                   Margin="0,0,6,0"/>
                                        <Button Content="Hôm nay" Height="28" Padding="10,0" 
                                                Margin="0,0,5,0" Background="White" 
                                                Foreground="#1E40AF" FontSize="11"
                                                BorderBrush="#BFDBFE" BorderThickness="1"
                                                Click="btnNhanhHomNay_Click"/>
                                        <Button Content="7 ngày" Height="28" Padding="10,0" 
                                                Margin="0,0,5,0" Background="White" 
                                                Foreground="#1E40AF" FontSize="11"
                                                BorderBrush="#BFDBFE" BorderThickness="1"
                                                Click="btnNhanh7Ngay_Click"/>
                                        <Button Content="Tháng này" Height="28" Padding="10,0"
                                                Background="White" Foreground="#1E40AF" 
                                                FontSize="11"
                                                BorderBrush="#BFDBFE" BorderThickness="1"
                                                Click="btnNhanhThangNay_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Canvas vẽ biểu đồ tròn -->
                        <Canvas x:Name="canvasBieuDoTron" Grid.Row="2" 
                                MinHeight="320" SizeChanged="canvasBieuDoTron_SizeChanged"/>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- CỘT PHẢI: BIỂU ĐỒ CỘT + BỘ LỌC RIÊNG       -->
                <!-- ============================================ -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" 
                        BorderThickness="1" CornerRadius="12" Padding="20" MinHeight="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề -->
                        <TextBlock x:Name="txtTieuDeBieuDoCot" Text="SO SÁNH THU CHI" 
                                   FontWeight="Bold" FontSize="14" Foreground="#4B5563" 
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <!-- BỘ LỌC RIÊNG CHO BIỂU ĐỒ CỘT -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <!-- ComboBox Kiểu -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📅 Kiểu:" VerticalAlignment="Center" 
                                           FontSize="13" FontWeight="Medium" 
                                           Foreground="#374151" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cboKieuSoSanh" Width="220" Height="34" 
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="cboKieuSoSanh_SelectionChanged" 
                                          FontSize="12">
                                    <ComboBoxItem Content="📊 So sánh 2 tháng" IsSelected="True"/>
                                    <ComboBoxItem Content="📈 Biểu đồ 12 tháng"/>
                                    <ComboBoxItem Content="📅 1 tháng cụ thể"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Panel chọn 2 tháng -->
                            <Border x:Name="pnlChon2Thang" 
                                    Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                    CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="📅 Tháng 1:" VerticalAlignment="Center" 
                                                   FontSize="12" FontWeight="Medium" 
                                                   Foreground="#166534" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="cboThang1" Width="130" Height="30" 
                                                  VerticalContentAlignment="Center" 
                                                  FontSize="12" Margin="0,0,15,0"
                                                  SelectionChanged="cboThang1_SelectionChanged"/>

                                        <TextBlock Text="📅 Tháng 2:" VerticalAlignment="Center" 
                                                   FontSize="12" FontWeight="Medium" 
                                                   Foreground="#166534" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="cboThang2" Width="130" Height="30" 
                                                  VerticalContentAlignment="Center" 
                                                  FontSize="12"
                                                  SelectionChanged="cboThang2_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Nhanh:" VerticalAlignment="Center" 
                                                   FontSize="11" Foreground="#6B7280" 
                                                   Margin="0,0,6,0"/>
                                        <Button Content="T9 vs T8" Height="28" Padding="10,0" 
                                                Margin="0,0,5,0" Background="White" 
                                                Foreground="#166534" FontSize="11"
                                                BorderBrush="#BBF7D0" BorderThickness="1"
                                                Click="btnNhanhT9vsT8_Click"/>
                                        <Button Content="6 tháng" Height="28" Padding="10,0"
                                                Background="White" Foreground="#166534" 
                                                FontSize="11"
                                                BorderBrush="#BBF7D0" BorderThickness="1"
                                                Click="btnNhanh6Thang_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Panel chọn 1 tháng -->
                            <Border x:Name="pnlChon1Thang" 
                                    Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                    CornerRadius="6" Padding="8,6" 
                                    Visibility="Collapsed" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 Chọn tháng:" VerticalAlignment="Center" 
                                               FontSize="12" FontWeight="Medium" 
                                               Foreground="#92400E" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="cboThangDuyNhat" Width="130" Height="30" 
                                              VerticalContentAlignment="Center" 
                                              FontSize="12" Margin="0,0,10,0"
                                              SelectionChanged="cboThangDuyNhat_SelectionChanged"/>
                                    <TextBlock Text="💡 Xem chi tiết 1 tháng" 
                                               VerticalAlignment="Center" FontSize="11" 
                                               Foreground="#92400E" FontStyle="Italic"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Canvas vẽ biểu đồ cột -->
                        <Canvas x:Name="canvasBieuDoCot" Grid.Row="2" 
                                MinHeight="280" SizeChanged="canvasBieuDoCot_SizeChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- BẢNG TOP DANH MỤC -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" 
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🏆 TOP DANH MỤC CHI NHIỀU NHẤT" 
                               FontWeight="Bold" FontSize="13" Foreground="#4B5563" 
                               Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgvTopDanhMuc" Grid.Row="1" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                              Background="Transparent" BorderThickness="0" 
                              RowHeight="38" ColumnHeaderHeight="36"
                              FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#374151"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hạng" Binding="{Binding Hang}" Width="70"/>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding TenDanhMuc}" Width="*"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTienHienThi}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tỷ lệ" Binding="{Binding TyLeHienThi}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>