<Page x:Class="WpfApp.DanhMuc"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Title="Danh mục" Background="#F5F6FA">

    <Page.Resources>
        <!-- Style chung cho các nút bấm có hiệu ứng -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Danh mục"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>
                <TextBlock Text="Quản lý thông tin các danh mục thu chi"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- TÌM KIẾM -->
            <Border Width="280"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBlock Text="🔍"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="#9CA3AF"/>
                    <TextBox x:Name="txtTimKiem"
                             Margin="38,0,10,0"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             TextChanged="txtTimKiem_TextChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="btnThem"
                        Content="＋ Thêm"
                        Width="110" Height="40"
                        Margin="0,0,10,0"
                        Background="#2563EB"
                        Foreground="White"
                        Click="btnThem_Click"/>

                <Button x:Name="btnSua"
                        Content="✎ Sửa"
                        Width="110" Height="40"
                        Margin="0,0,10,0"
                        Background="#D97706"
                        Foreground="White"
                        Click="btnSua_Click"/>

                <Button x:Name="btnXoa"
                        Content="🗑 Xóa"
                        Width="110" Height="40"
                        Margin="0,0,10,0"
                        Background="#DC2626"
                        Foreground="White"
                        Click="btnXoa_Click"/>

                <Button x:Name="btnLamMoi"
                        Content="⟳ Làm mới"
                        Width="120" Height="40"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Click="btnLamMoi_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- TABLE -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="1">

                <DataGrid x:Name="dataGridDanhMuc"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="48"
                          FontSize="14"
                          ColumnHeaderHeight="45">

                    <!-- Style cho phần tiêu đề cột DataGrid -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,0"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT"
                                            Binding="{Binding STT}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Mã danh mục"
                                            Binding="{Binding MaDanhMuc}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Tên danh mục"
                                            Binding="{Binding TenDanhMuc}"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="Trạng thái" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#DCFCE7"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="Đang hoạt động"
                                                   Foreground="#15803D"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>