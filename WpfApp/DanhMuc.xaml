<Page x:Class="WpfApp.DanhMuc"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Title="Danh mục">

    <Grid Background="#F5F6FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="25,0">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DANH MỤC"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Quản lý thông tin danh mục"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- TÌM KIẾM -->
                <Border Width="280"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#F3F4F6"
                        CornerRadius="8">

                    <Grid>
                        <TextBlock Text="🔍"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                        <TextBox x:Name="txtTimKiem"
                                 Margin="38,0,10,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 TextChanged="txtTimKiem_TextChanged"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>


        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- BUTTON -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <Button x:Name="btnThem"
                        Content="＋  Thêm"
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="btnThem_Click"/>

                <Button x:Name="btnSua"
                        Content="✎  Sửa"
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#F59E0B"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="btnSua_Click"/>

                <Button x:Name="btnXoa"
                        Content="🗑  Xóa"
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="btnXoa_Click"/>

                <Button x:Name="btnLamMoi"
                        Content="⟳  Làm mới"
                        Width="120"
                        Height="40"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        FontSize="14"
                        Cursor="Hand"
                        Click="btnLamMoi_Click"/>

            </StackPanel>


            <!-- TABLE -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TABLE HEADER -->
                    <Border Grid.Row="0"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="STT"
                                       FontWeight="Bold"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="Mã danh mục"
                                       FontWeight="Bold"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="Tên danh mục"
                                       FontWeight="Bold"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Trạng thái"
                                       FontWeight="Bold"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"/>

                        </Grid>
                    </Border>


                    <!-- DATA -->
                    <DataGrid x:Name="dataGridDanhMuc"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="None"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              RowHeight="48"
                              FontSize="14">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="STT"
                                                Binding="{Binding STT}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Mã"
                                                Binding="{Binding MaDanhMuc}"
                                                Width="180"/>

                            <DataGridTextColumn Header="Tên"
                                                Binding="{Binding TenDanhMuc}"
                                                Width="*"/>

                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="180">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border Background="#DCFCE7"
                                                CornerRadius="12"
                                                Padding="12,5"
                                                HorizontalAlignment="Left">

                                            <TextBlock Text="Đang hoạt động"
                                                       Foreground="#15803D"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>

                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>