<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Phần mềm Quản lý Tài chính Cá nhân - My Finance" 
        Height="680" Width="1050"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900">

    <Grid>
        <!-- ĐỊNH NGHĨA GIAO DIỆN CHUNG CHO CÁC NÚT (STYLE) -->
        <Grid.Resources>
            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <!-- Màu chữ xám dịu mắt hơn -->
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="20,10,0,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="BorderThickness" Value="4,0,0,0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>

                <!-- Ghi đè thiết kế mặc định của WPF để tạo nút phẳng -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!-- Hiệu ứng khi di chuột (Hover) -->
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#334155"/>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- CHIA CỘT -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <!-- Mở rộng thanh Menu -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU BÊN TRÁI (SIDEBAR) -->
        <Border Grid.Column="0" Background="#1E293B">
            <StackPanel>

                <!-- Logo / Tiêu đề ứng dụng -->
                <StackPanel Orientation="Horizontal" Margin="20,25,20,20" HorizontalAlignment="Center">
                    <TextBlock Text="💰" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="My Finance" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Đường kẻ phân cách ngang -->
                <Rectangle Height="1" Fill="#334155" Margin="20,0,20,15"/>

                <!-- Danh sách Nút Menu chính -->
                <Button x:Name="btnMenuTongQuan" Content="📊  Tổng quan" Style="{StaticResource MenuButtonStyle}" Click="btnMenuTongQuan_Click"/>
                <Button x:Name="btnMenuGiaoDich" Content="💸  Giao dịch" Style="{StaticResource MenuButtonStyle}" Click="btnMenuGiaoDich_Click"/>
                <Button x:Name="btnMenuDanhMuc" Content="📂  Danh mục" Style="{StaticResource MenuButtonStyle}" Click="btnMenuDanhMuc_Click"/>
                <Button x:Name="btnMenuNganSach" Content="🎯  Ngân sách" Style="{StaticResource MenuButtonStyle}" Click="btnMenuNganSach_Click"/>
                <Button x:Name="btnMenuMucTieu" Content="⭐  Mục tiêu tiết kiệm" Style="{StaticResource MenuButtonStyle}" Click="btnMenuMucTieu_Click"/>
                <Button x:Name="btnMenuPhanTich" Content="📈  Phân tích" Style="{StaticResource MenuButtonStyle}" Click="btnMenuPhanTich_Click"/>

                <!-- Đường kẻ phân cách hệ thống -->
                <Rectangle Height="1" Fill="#334155" Margin="20,15,20,10"/>

                <Button x:Name="btnMenuTroLyAI" Content="🤖  Trợ lý AI" Style="{StaticResource MenuButtonStyle}" Click="btnMenuTroLyAI_Click"/>
                <Button x:Name="btnMenuCaiDat" Content="⚙️  Cài đặt" Style="{StaticResource MenuButtonStyle}" Click="btnMenuCaiDat_Click"/>

            </StackPanel>
        </Border>

        <!-- VÙNG HIỂN THỊ PAGE BÊN PHẢI -->
        <Frame x:Name="MainFrame" 
       Grid.Column="1" 
       NavigationUIVisibility="Hidden" 
       Margin="10"/>
    </Grid>
</Window>