<Window x:Class="WpfApp.DangKy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="DangKy" Height="450" Width="800">
    <Grid>
        <!-- Khung chứa căn giữa màn hình -->
        <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Nút Tạo tài khoản gắn với sự kiện btnTaoTaiKhoan_Click -->
            <Button x:Name="btnTaoTaiKhoan" 
                Content="Tạo Tài Khoản" 
                Height="40" 
                Margin="0,0,0,10" 
                Click="btnTaoTaiKhoan_Click"/>

            <!-- Nút Quay lại gắn với sự kiện btnQuayLai_Click -->
            <Button x:Name="btnQuayLai" 
                Content="Quay lại" 
                Height="40" 
                Click="btnQuayLai_Click"/>

        </StackPanel>
    </Grid>
</Window>
