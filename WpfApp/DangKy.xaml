<Window x:Class="WpfApp.DangKy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Đăng Ký Tài Khoản" Height="580" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Background="#F5F6FA">
        <!-- Khung form đăng ký căn giữa -->
        <Border Width="360" Background="White" CornerRadius="10" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <!-- Tiêu đề -->
                <TextBlock Text="ĐĂNG KÝ" FontSize="24" FontWeight="Bold" Foreground="#2F3640" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Tên đăng nhập -->
                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Foreground="#57606F" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTaiKhoan" Height="35" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Email -->
                <TextBlock Text="Email xác thực" FontWeight="SemiBold" Foreground="#57606F" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Foreground="#57606F" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtMatKhau" Height="35" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Nhập lại mật khẩu -->
                <TextBlock Text="Xác nhận mật khẩu" FontWeight="SemiBold" Foreground="#57606F" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtXacNhanMatKhau" Height="35" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <!-- Nút Gửi Mã Xác Thực & Đăng Ký -->
                <Button x:Name="btnTaoTaiKhoan" 
                        Content="Gửi Mã Xác Thực Email" 
                        Height="40" 
                        Background="#007ACC" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0,0,0,10" 
                        Click="btnTaoTaiKhoan_Click"/>

                <!-- Nút Quay lại -->
                <Button x:Name="btnQuayLai" 
                        Content="Quay lại đăng nhập" 
                        Height="35" 
                        Background="Transparent" 
                        Foreground="#57606F" 
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Click="btnQuayLai_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>