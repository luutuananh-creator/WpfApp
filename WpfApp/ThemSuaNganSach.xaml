<Window x:Class="WpfApp.ThemSuaNganSach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết Lập Ngân Sách" Height="420" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Window.Resources>
        <!-- Style Label chung -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <!-- Style ComboBox & TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- Form nhập liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Các nút bấm -->
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ -->
        <TextBlock x:Name="txtTieuDe" 
                   Text="THÊM NGÂN SÁCH MỚI" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#10B981" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,16"/>

        <!-- 2. FORM NHẬP LIỆU -->
        <StackPanel Grid.Row="1">
            <!-- Chọn Danh Mục -->
            <Label Content="Danh mục chi tiêu:"/>
            <ComboBox x:Name="cboDanhMuc" 
                      DisplayMemberPath="TenDanhMuc" 
                      SelectedValuePath="MaDanhMuc"/>

            <!-- Chọn Thời Gian (Tháng & Năm) -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Tháng:"/>
                    <ComboBox x:Name="cboThang"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Năm:"/>
                    <TextBox x:Name="txtNam"/>
                </StackPanel>
            </Grid>

            <!-- Nhập Hạn Mức -->
            <Label Content="Hạn mức ngân sách (VNĐ):"/>
            <TextBox x:Name="txtHanMuc" PreviewTextInput="txtHanMuc_PreviewTextInput"/>
        </StackPanel>

        <!-- 3. NÚT HÀNH ĐỘNG -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnHuy" 
                    Content="Hủy bỏ" 
                    Width="100" 
                    Height="36" 
                    Margin="0,0,12,0" 
                    Background="#E5E7EB" 
                    Foreground="#374151" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="btnHuy_Click"/>

            <Button x:Name="btnLuu" 
                    Content="Lưu thông tin" 
                    Width="120" 
                    Height="36" 
                    Background="#10B981" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="btnLuu_Click"/>
        </StackPanel>
    </Grid>
</Window>