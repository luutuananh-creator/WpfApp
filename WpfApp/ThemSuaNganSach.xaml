<Window x:Class="WpfApp.ThemSuaNganSach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết Lập Ngân Sách" Height="460" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- Style chung cho các nút bấm bo góc -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- Form nhập liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Các nút bấm -->
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="txtTieuDe" Text="Thiết lập ngân sách" FontSize="22" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
            <TextBlock Text="Quản lý hạn mức chi tiêu theo tháng và danh mục" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. FORM NHẬP LIỆU -->
        <StackPanel Grid.Row="1">
            <!-- Chọn Danh Mục -->
            <TextBlock Text="Danh mục chi tiêu:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboDanhMuc" Height="40" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,14"
                      DisplayMemberPath="TenDanhMuc" SelectedValuePath="MaDanhMuc"/>

            <!-- Chọn Thời Gian (Tháng & Năm) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tháng:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboThang" Height="40" VerticalContentAlignment="Center" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Năm:" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="40">
                        <TextBox x:Name="txtNam" BorderThickness="0" Background="Transparent" 
                                 VerticalContentAlignment="Center" FontSize="14" Padding="10,0"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Nhập Hạn Mức -->
            <TextBlock Text="Hạn mức ngân sách (VNĐ):" FontWeight="Medium" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="42">
                <TextBox x:Name="txtHanMuc" BorderThickness="0" Background="Transparent" 
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right" 
                         FontSize="16" FontWeight="Bold" Foreground="#10B981" Padding="10,0"
                         PreviewTextInput="txtHanMuc_PreviewTextInput"/>
            </Border>
        </StackPanel>

        <!-- 3. NÚT HÀNH ĐỘNG -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnHuy" Grid.Column="0" Content="Hủy bỏ" Height="42" 
                    Background="#94A3B8" Foreground="White" FontSize="14" 
                    Click="btnHuy_Click"/>

            <Button x:Name="btnLuu" Grid.Column="2" Content="💾 Lưu ngân sách" Height="42" 
                    Background="#10B981" Foreground="White" FontSize="14" 
                    Click="btnLuu_Click"/>
        </Grid>
    </Grid>
</Window>