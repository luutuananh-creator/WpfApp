<Window x:Class="WpfApp.DoiMatKhau"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Quên Mật Khẩu" Height="600" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid Margin="30">
        <Border Background="White" CornerRadius="12" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel>

                <!-- ============================================ -->
                <!-- BƯỚC 1: NHẬP EMAIL                            -->
                <!-- ============================================ -->
                <StackPanel x:Name="spNhapEmail">
                    <TextBlock Text="🔑 QUÊN MẬT KHẨU"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Nhập email đã đăng ký để nhận mã OTP"
                               FontSize="12" Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Email đã đăng ký" FontWeight="SemiBold"
                               Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail"
                             Height="38" Padding="8,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                    <Button x:Name="btnGuiOTP"
                            Content="📧 Gửi mã xác thực"
                            Height="42"
                            Background="#2563EB" Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="btnGuiOTP_Click"/>
                </StackPanel>

                <!-- ============================================ -->
                <!-- BƯỚC 2: NHẬP OTP + MẬT KHẨU MỚI               -->
                <!-- ============================================ -->
                <StackPanel x:Name="spNhapOTP" Visibility="Collapsed">
                    <TextBlock Text="🔐 ĐẶT LẠI MẬT KHẨU"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Nhập mã OTP và mật khẩu mới"
                               FontSize="12" Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- OTP -->
                    <TextBlock Text="Mã OTP (6 chữ số)" FontWeight="SemiBold"
                               Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtOTP"
                             Height="38" Padding="8,0"
                             VerticalContentAlignment="Center"
                             FontSize="14" MaxLength="6"
                             Margin="0,0,0,15"/>

                    <!-- Mật khẩu mới -->
                    <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold"
                               Foreground="#4B5563" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtMatKhauMoi"
                                 Height="38" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                    <!-- Xác nhận -->
                    <TextBlock Text="Xác nhận mật khẩu mới" FontWeight="SemiBold"
                               Foreground="#4B5563" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtXacNhan"
                                 Height="38" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,0,20"/>

                    <!-- Nút Xác nhận -->
                    <Button x:Name="btnXacNhanDoi"
                            Content="✅ Xác nhận đổi mật khẩu"
                            Height="42"
                            Background="#10B981" Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="btnXacNhanDoi_Click"/>

                    <!-- Nút gửi lại OTP -->
                    <Button x:Name="btnGuiLaiOTP"
                            Content="🔄 Gửi lại mã OTP"
                            Background="Transparent" Foreground="#2563EB"
                            BorderThickness="0" FontSize="12"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5"
                            Click="btnGuiLaiOTP_Click"/>
                </StackPanel>

                <!-- ============================================ -->
                <!-- NÚT QUAY LẠI ĐĂNG NHẬP                        -->
                <!-- ============================================ -->
                <Button x:Name="btnQuayLai"
                        Content="← Quay lại đăng nhập"
                        Height="38"
                        Background="Transparent" Foreground="#6B7280"
                        FontWeight="SemiBold" FontSize="13"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,10,0,0"
                        Click="btnQuayLai_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>