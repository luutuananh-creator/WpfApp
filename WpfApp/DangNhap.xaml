<Window x:Class="WpfApp.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="DangNhap" Height="450" Width="800">
    <Grid>
        <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="ĐĂNG NHẬP" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Nhập tài khoản -->
            <TextBlock Text="Tên đăng nhập / Email:" />
            <TextBox x:Name="txtTenDangNhap" Margin="0,0,0,10" Padding="5" />

            <!-- Nhập mật khẩu -->
            <TextBlock Text="Mật khẩu:" />
            <PasswordBox x:Name="txtMatKhau" Margin="0,0,0,5" Padding="5" />

            <!-- === THÊM NÚT QUÊN MẬT KHẨU TẠI ĐÂY === -->
            <Button x:Name="btnQuenMatKhau" Content="Quên mật khẩu?" 
                Background="Transparent" Foreground="#0078D7" BorderThickness="0" 
                HorizontalAlignment="Right" Margin="0,0,0,10" Cursor="Hand"
                Click="btnQuenMatKhau_Click"/>
            <!-- ===================================== -->

            <!-- Checkbox ghi nhớ -->
            <CheckBox x:Name="chkGhiNho" Content="Ghi nhớ đăng nhập" Margin="0,0,0,15"/>

            <!-- Nút Đăng nhập -->
            <Button x:Name="btnDangNhap" Content="Đăng Nhập" Height="35" Margin="0,0,0,10" Background="#0078D7" Foreground="White" 
                Click="btnDangNhap_Click"/>

            <!-- Nút Đăng ký -->
            <Button x:Name="btnDangKy" Content="Chưa có tài khoản? Đăng ký ngay" Height="35" Background="LightGray"
                Click="btnDangKy_Click"/>

        </StackPanel>
    </Grid>
</Window>
