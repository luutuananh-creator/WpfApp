<Window x:Class="WpfApp.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Đăng nhập" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid Margin="150">
        <Border Background="White" CornerRadius="12" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel>

                <!-- ============================================================ -->
                <!-- KHỐI 1: FORM ĐĂNG NHẬP ĐẦY ĐỦ (hiện mặc định)                 -->
                <!-- ============================================================ -->
                <StackPanel x:Name="spDangNhapDayDu">

                    <TextBlock Text="ĐĂNG NHẬP"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- Tên đăng nhập -->
                    <TextBlock Text="Tên đăng nhập / Email:"
                               FontWeight="SemiBold" Foreground="#4B5563"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTenDangNhap"
                             Height="38" Padding="8,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Margin="0,0,0,15"/>

                    <!-- Mật khẩu -->
                    <TextBlock Text="Mật khẩu:"
                               FontWeight="SemiBold" Foreground="#4B5563"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtMatKhau"
                                 Height="38" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,0,5"/>

                    <!-- Quên mật khẩu -->
                    <Button x:Name="btnQuenMatKhau"
                            Content="Quên mật khẩu?"
                            Background="Transparent"
                            Foreground="#2563EB"
                            BorderThickness="0"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            Margin="0,0,0,15"
                            Click="btnQuenMatKhau_Click"/>

                    <!-- Ghi nhớ đăng nhập -->
                    <CheckBox x:Name="chkGhiNho"
                              Content="Ghi nhớ đăng nhập"
                              Foreground="#4B5563"
                              Margin="0,0,0,20"/>

                    <!-- Nút Đăng nhập -->
                    <Button x:Name="btnDangNhap"
                            Content="Đăng Nhập"
                            Height="42"
                            Background="#2563EB" Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="btnDangNhap_Click"/>

                    <!-- Nút Đăng ký -->
                    <Button x:Name="btnDangKy"
                            Content="Chưa có tài khoản? Đăng ký ngay"
                            Height="38"
                            Background="LightGray" Foreground="#1F2937"
                            FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Cursor="Hand"
                            Click="btnDangKy_Click"/>
                </StackPanel>

                <!-- ============================================================ -->
                <!-- KHỐI 2: XIN CHÀO (hiện khi đã ghi nhớ lần trước)              -->
                <!-- ============================================================ -->
                <StackPanel x:Name="spXinChao" Visibility="Collapsed">

                    <TextBlock Text="ĐĂNG NHẬP"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="👤"
                               FontSize="60"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="txtLoiChao"
                               Text="Xin chào, ..."
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Bạn đã ghi nhớ đăng nhập lần trước"
                               FontSize="12" Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <!-- Nút Đăng nhập nhanh -->
                    <Button x:Name="btnDangNhapNhanh"
                            Content="🚀 Đăng nhập nhanh"
                            Height="42"
                            Background="#10B981" Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="btnDangNhapNhanh_Click"/>

                    <!-- Nút Quay lại (Đổi tài khoản khác) -->
                    <Button x:Name="btnQuayLai"
                            Content="← Quay lại (Đổi tài khoản)"
                            Height="38"
                            Background="Transparent" Foreground="#6B7280"
                            FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Cursor="Hand"
                            Click="btnQuayLai_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>