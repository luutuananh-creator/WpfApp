<Page x:Class="WpfApp.TongQuan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="TongQuan">

    <Grid Margin="20">
        <!-- Chia trang thành 5 dòng -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 0: Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 1: Các thẻ Tổng thu, Tổng chi, Số dư -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 2: Tình trạng ngân sách -->
            <RowDefinition Height="*"/>
            <!-- Dòng 3: Biểu đồ -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 4: Các nút hành động -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="TỔNG QUAN TÀI CHÍNH" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- 3 THẺ TÓM TẮT (Tổng thu, Tổng chi, Số dư) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thẻ Tổng thu -->
            <Border Grid.Column="0" Background="#E8F5E9" Padding="15" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Tổng Thu" FontSize="14" Foreground="#2E7D32"/>
                    <!-- BỔ SUNG x:Name="txtTongThu" -->
                    <TextBlock x:Name="txtTongThu" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thẻ Tổng chi -->
            <Border Grid.Column="2" Background="#FFEBEE" Padding="15" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Tổng Chi" FontSize="14" Foreground="#C62828"/>
                    <!-- BỔ SUNG x:Name="txtTongChi" -->
                    <TextBlock x:Name="txtTongChi" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#C62828" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thẻ Số dư -->
            <Border Grid.Column="4" Background="#E3F2FD" Padding="15" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Số Dư" FontSize="14" Foreground="#1565C0"/>
                    <!-- BỔ SUNG x:Name="txtSoDu" -->
                    <TextBlock x:Name="txtSoDu" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TÌNH TRẠNG NGÂN SÁCH -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Tình trạng ngân sách tháng này" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <!-- BỔ SUNG x:Name="pbNganSach" -->
            <ProgressBar x:Name="pbNganSach" Value="0" Maximum="100" Height="20" Foreground="#FFC107" Background="#E0E0E0"/>

            <!-- BỔ SUNG x:Name="txtThongTinNganSach" -->
            <TextBlock x:Name="txtThongTinNganSach" Text="Đã chi 0% (0 / 0 đ)" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Right" Foreground="Gray"/>
        </StackPanel>

        <!-- BIỂU ĐỒ (Tạm thời dùng Border) -->
        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
            <TextBlock Text="[Khu vực hiển thị Biểu đồ tổng quan]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
        </Border>

        <!-- CÁC NÚT HÀNH ĐỘNG -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnXemGiaoDich" Content="Xem Giao dịch" Width="130" Height="40" Margin="0,0,15,0" 
                    Background="#0078D7" Foreground="White" Click="btnXemGiaoDich_Click"/>

            <Button x:Name="btnXemNganSach" Content="Xem Ngân sách" Width="130" Height="40" Margin="0,0,15,0" 
                    Background="#0078D7" Foreground="White" Click="btnXemNganSach_Click"/>

            <Button x:Name="btnXemPhanTich" Content="Xem Phân tích" Width="130" Height="40" 
                    Background="#0078D7" Foreground="White" Click="btnXemPhanTich_Click"/>
        </StackPanel>
    </Grid>
</Page>