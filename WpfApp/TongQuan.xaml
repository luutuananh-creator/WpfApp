<Page x:Class="WpfApp.TongQuan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="850"
      Title="TongQuan" Background="#F8F9FA">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 0: Tiêu đề & Bộ lọc -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 1: Thẻ Tổng thu, Tổng chi, Số dư -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 2: Tình trạng ngân sách -->
            <RowDefinition Height="*"/>
            <!-- Dòng 3: Biểu đồ -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 4: Các nút hành động -->
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ & BỘ LỌC THỜI GIAN -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tổng quan tài chính" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Báo cáo tình hình tài chính của bạn" FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bộ lọc thời gian -->
            <ComboBox x:Name="cboThoiGian" Grid.Column="1" Width="160" Height="38" VerticalContentAlignment="Center" FontSize="13"
                      SelectionChanged="cboThoiGian_SelectionChanged">
                <ComboBoxItem Content="Tháng này" IsSelected="True"/>
                <ComboBoxItem Content="Tháng trước"/>
                <ComboBoxItem Content="3 tháng gần đây"/>
                <ComboBoxItem Content="Năm nay"/>
            </ComboBox>
        </Grid>

        <!-- 3 THẺ TÓM TẮT -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thẻ Tổng thu -->
            <Border Grid.Column="0" Background="White" Padding="20" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Tổng Thu" FontSize="13" Foreground="#6C757D" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock x:Name="txtTongThu" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#2ECC71" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thẻ Tổng chi -->
            <Border Grid.Column="2" Background="White" Padding="20" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📉" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Tổng Chi" FontSize="13" Foreground="#6C757D" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock x:Name="txtTongChi" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thẻ Số dư -->
            <Border Grid.Column="4" Background="White" Padding="20" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Số Dư" FontSize="13" Foreground="#6C757D" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock x:Name="txtSoDu" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#3498DB" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TÌNH TRẠNG NGÂN SÁCH -->
        <Border Grid.Row="2" Background="White" Padding="20" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Tình trạng ngân sách" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,12"/>

                <ProgressBar x:Name="pbNganSach" Value="0" Maximum="100" Height="10" Foreground="#3498DB" Background="#ECF0F1"/>

                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="txtThongTinNganSach" Text="Đã chi 0% (0 / 0 đ)" FontSize="12" Foreground="#7F8C8D"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BIỂU ĐỒ TỰ VẼ (CANVAS CHART) -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="12" Margin="0,0,0,20" Padding="15">
            <Grid x:Name="gridContainerBieuDo">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📊 Cơ cấu chi tiêu theo danh mục" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                <Canvas x:Name="canvasBieuDo" Grid.Row="1" MinHeight="160" SizeChanged="canvasBieuDo_SizeChanged"/>
            </Grid>
        </Border>

        <!-- CÁC NÚT HÀNH ĐỘNG -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnXemGiaoDich" Content="Xem Giao dịch" Width="130" Height="38" Margin="0,0,10,0" 
                    Background="#3498DB" Foreground="White" Click="btnXemGiaoDich_Click"/>

            <Button x:Name="btnXemNganSach" Content="Xem Ngân sách" Width="130" Height="38" Margin="0,0,10,0" 
                    Background="#2ECC71" Foreground="White" Click="btnXemNganSach_Click"/>

            <Button x:Name="btnXemPhanTich" Content="Xem Phân tích" Width="130" Height="38" 
                    Background="#9B59B6" Foreground="White" Click="btnXemPhanTich_Click"/>
        </StackPanel>
    </Grid>
</Page>