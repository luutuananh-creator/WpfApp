<Page x:Class="WpfApp.TongQuan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TongQuan">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="btnXemGiaoDich" Content="Xem Giao dịch" Height="40" Click="btnXemGiaoDich_Click"/>
            <Button x:Name="btnXemNganSach" Content="Xem Ngân sách" Height="40" Click="btnXemNganSach_Click"/>
            <Button x:Name="btnXemPhanTich" Content="Xem Phân tích" Height="40" Click="btnXemPhanTich_Click"/>
        </StackPanel>
    </Grid>
</Page>
